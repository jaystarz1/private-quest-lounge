#!/usr/bin/env node
// Paired control. Chrome's existence is not evidence of a live screen share.
const http = require("http");
const path = require("path");
const os = require("os");
const { execFile, execFileSync } = require("child_process");
const { promisify } = require("util");
const { TvService, handler, openStore } = require("./lib/tv-service.cjs");
const origin = "https://lounge.thechatbotgenius.com";
const switcher = "/opt/homebrew/bin/SwitchAudioSource";
const audio = {
  available: () => execFileSync(switcher, ["-a", "-t", "output"], { encoding: "utf8" }).split("\n").includes("BlackHole 2ch"),
  current: () => execFileSync(switcher, ["-c", "-t", "output"], { encoding: "utf8" }).trim(),
  set: name => execFileSync(switcher, ["-s", name, "-t", "output"], { stdio: "ignore" })
};
const service = new TvService({
  store: openStore(path.join(__dirname, "..", ".lounge-tv")), audio,
  source: process.env.LOUNGE_TV_DISPLAY || "Screen 1",
  launch: (token, source) => promisify(execFile)("open", ["-na", "Google Chrome", "--args",
    `--user-data-dir=${path.join(os.homedir(), ".lounge-tv-chrome")}`, "--no-first-run",
    `--auto-select-desktop-capture-source=${source}`,
    `${origin}/FxjfVW8/the-lounge?tv=1#tv-session=${token}`])
});
const server = http.createServer(handler(service, origin));
server.requestTimeout = 10000;
server.headersTimeout = 10000;
server.listen(9917, "127.0.0.1", () => console.log("TV control ready on localhost:9917. Run node bin/tv-control pair to pair a headset."));
const timer = setInterval(() => service.tick(), 1000);
for (const signal of ["SIGINT", "SIGTERM"]) process.once(signal, () => {
  service.stop();
  clearInterval(timer);
  server.close(() => process.exit());
  setTimeout(() => process.exit(), 2000).unref();
});
