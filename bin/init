#!/bin/bash
basedir=$(cd "$(dirname "$0")"/.. && pwd)
source "$basedir"/bin/lib-env

prefix='\n\033[1;37m'
suffix='\033[0m\n'

servicesdir=$basedir/services
echo -e ${prefix}Cloning source repositories$suffix
[ -d "$servicesdir"/reticulum ] || git clone https://github.com/Hubs-Foundation/reticulum.git "$servicesdir"/reticulum
[ -d "$servicesdir"/dialog ] || git clone https://github.com/Hubs-Foundation/dialog.git "$servicesdir"/dialog
[ -d "$servicesdir"/hubs ] || git clone https://github.com/Hubs-Foundation/hubs.git "$servicesdir"/hubs
[ -d "$servicesdir"/spoke ] || git clone https://github.com/Hubs-Foundation/Spoke.git "$servicesdir"/spoke

echo -e ${prefix}Initializing Reticulum$suffix &&
compose build reticulum &&
compose run --rm reticulum sh -c 'trapped-mix do deps.get, deps.compile, ecto.create' &&
echo -e ${prefix}Initializing Dialog$suffix &&
compose build dialog &&
compose run --rm dialog conditional-npm-ci &&
echo -e ${prefix}Initializing Hubs Admin$suffix &&
compose build hubs-admin &&
compose run --rm hubs-admin conditional-npm-ci &&
echo -e ${prefix}Initializing Hubs Client$suffix &&
compose build hubs-client &&
compose run --rm hubs-client conditional-npm-ci

code=$?
compose down
exit $code
